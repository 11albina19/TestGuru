<div class="container mt-2">
  <h1 class="mb-4"><%= t('.header') %></h1>
  <p>
    <%= link_to t('.create'), new_admins_badge_path, class: "btn btn-primary" %>
  </p>

  <%= render 'shared/errors', resource: @badge %>

  <table class="table table-striped table-hover">
    <thead class="table-dark">
    <tr>
      <th class="sort-by-title pointer">
        <%= t('.title') %>
        <%= octicon 'arrow-up', class: 'text-success hide' %>
        <%= octicon 'arrow-down', class: 'text-success hide' %>
      </th>
      <th><%= t('.level') %></th>
      <th><%= t('.time_limit') %></th>
      <th><%= t('.questions') %></th>
      <th colspan="3"><%= t('.actions') %></th>
    </tr>
    </thead>
    <tbody>
    <%= render @badges %>
    </tbody>
  </table>
</div>
