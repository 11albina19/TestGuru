<tr>
  <td><%= question.body %></td>
  <td><%= link_to 'Открыть', admins_test_question_path(question.test, question) %></td>
  <td><%= link_to 'Редактировать', edit_admins_test_question_path(question.test, question) %></td>
  <td>
    <%= link_to t('.delete'),
                [:admins, question.test, question],
                data: { turbo_method: :delete, turbo_confirm: t('.sure') },
                class: "btn btn-outline-danger btn-sm" %>
  </td>
</tr>
