<%= form_with model: [:admins, @test], local: true, data: { turbo: false } do |form| %>
<%= render 'shared/errors', resource: @test %>
  <p>
    <%= form.label :title, t('.title') %>
    <%= form.text_field :title, id: :test_title %>
  </p>
  <p>
    <%= form.label :level, t('.level')   %>
    <%= form.number_field :level, id: :test_level %>
  </p>
  <p>
    <%= form.label :time_limit, t('.time_limit')   %>
    <%= form.number_field :time_limit, id: :time_limit %>
  </p>
  <p>
    <%= form.label :category_id, t('.category')  %>
    <%= form.collection_select :category_id, Category.all, :id, :title, prompt: true %>
  </p>
  <p><%= form.submit t('.save') %></p>
<% end %>
<%= link_to t('.back'), admins_tests_path %>
